{
  "name": "svelte-zukan",
  "version": "0.9.1",
  "description": "Colocated component catalog for Svelte, served by a Vite plugin",
  "license": "MIT",
  "author": "oekazuma",
  "type": "module",
  "keywords": [
    "svelte",
    "vite-plugin",
    "component-catalog",
    "styleguide",
    "sveltekit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oekazuma/svelte-zukan.git",
    "directory": "packages/svelte-zukan"
  },
  "bugs": {
    "url": "https://github.com/oekazuma/svelte-zukan/issues"
  },
  "homepage": "https://oekazuma.github.io/svelte-zukan/",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "package": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "prepublishOnly": "pnpm run package"
  },
  "files": [
    "dist",
    "skills",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.zukan.svelte",
    "!dist/**/*.zukan.svelte.d.ts",
    "!dist/**/*.zukan.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5.20.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "axe-core": "^4.14.0",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/node": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/devtools": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-inspect": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "catalog:"
  }
}
